      <column caption='Arrival Day' datatype='string' name='[Calculation_0174061435645952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [intime])' />
      </column>
      <column caption='Patient Count' datatype='integer' name='[Calculation_0174061437050882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([stay_id])' />
      </column>
      <column caption='High Acuity Rate (all triage values)' datatype='real' default-format='p0.00%' name='[Calculation_2948666110099456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2975601070673924]) / COUNT([stay_id (triage.csv)])' />
      </column>
      <column caption='High Acuity Rate (known acuity)' datatype='real' default-format='p0.00%' name='[Calculation_2948666110935041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2975601070673924]) / COUNT([acuity])' />
      </column>
      <column caption='LOS Alert Status' datatype='string' name='[Calculation_2975601060892672]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Calculation_3331291279757312]) &gt; [Parameters].[Hadm Id Parameter]&#13;&#10;THEN &quot;Above Threshold&quot;&#13;&#10;ELSE &quot;Within Threshold&quot;&#13;&#10;END' />
      </column>
      <column caption='Patient LOS' datatype='integer' name='[Calculation_2975601064038401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [stay_id] : MAX([Calculation_3331291279757312]) }' />
      </column>
      <column caption='Avg LOS by Disposition LOD' datatype='real' name='[Calculation_2975601066295298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [disposition] : AVG([Calculation_2975601064038401]) }' />
      </column>
      <column caption='Nested Avg LOS by Disposition' datatype='real' name='[Calculation_2975601067941891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [disposition] :&#13;&#10;    AVG(&#13;&#10;        { FIXED [stay_id] :&#13;&#10;            MAX([Calculation_3331291279757312])&#13;&#10;        }&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='High Acuity Flag' datatype='integer' name='[Calculation_2975601070673924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [acuity] &lt;= 2 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='ED Length of Stay (Hours)' datatype='integer' name='[Calculation_3331291279757312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;hour&apos;, [intime], [outtime])' />
      </column>
      <column caption='Admission Flag' datatype='integer' name='[Calculation_3331291288481794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [disposition] = &quot;ADMITTED&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Admission Rate' datatype='real' default-format='p0.00%' name='[Calculation_3331291288698883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_3331291288481794])' />
      </column>
      <column aggregation='Sum' caption='Arrival Hour' datatype='integer' name='[Calculation_3331291295268868]' role='dimension' type='ordinal'>
