          <datasource-dependencies datasource='federated.11smwh80r0ff2t1g6drtx1qclxzg'>
            <column caption='LOS Alert Status' datatype='string' name='[Calculation_2975601060892672]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([Calculation_3331291279757312]) &gt; [Parameters].[Hadm Id Parameter]&#13;&#10;THEN &quot;Above Threshold&quot;&#13;&#10;ELSE &quot;Within Threshold&quot;&#13;&#10;END' />
