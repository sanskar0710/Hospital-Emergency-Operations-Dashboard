        <view>
          <datasources>
            <datasource caption='edstays.csv+ (Multiple Connections)' name='federated.11smwh80r0ff2t1g6drtx1qclxzg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='LOS Alert Threshold' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Hadm Id Parameter]' param-domain-type='range' role='measure' type='quantitative' value='8.0'>
              <calculation class='tableau' formula='8.0' />
              <range granularity='1.0' max='24.0' min='1.0' />
