    <worksheet name='Arrival Heat Map'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>PATIENT ARRIVALS BY DAY &amp; HOUR</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='edstays.csv+ (Multiple Connections)' name='federated.11smwh80r0ff2t1g6drtx1qclxzg' />
          </datasources>
          <datasource-dependencies datasource='federated.11smwh80r0ff2t1g6drtx1qclxzg'>
            <column caption='Arrival Day' datatype='string' name='[Calculation_0174061435645952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [intime])' />
            </column>
            <column caption='Patient Count' datatype='integer' name='[Calculation_0174061437050882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([stay_id])' />
            </column>
